  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development NODE_OPTIONS='--import ./instrument.server.mjs' vite --port 1515",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "og:generate": "tsx scripts/generate-og.ts",
    "uploads:cleanup": "tsx --env-file=.env scripts/cleanup.ts",
    "start": "node --env-file-if-exists=.env --import ./instrument.server.mjs --import tsx scripts/server.ts"
  },
  "dependencies": {
