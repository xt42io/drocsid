    "@tanstack/start-storage-context": "1.167.29",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.2",
    "emoji-picker-react": "^4.20.1",
    "lenis": "^1.3.26",
    "pg": "^8.23.0",
    "posthog-js": "^1.428.2",
    "posthog-node": "^5.51.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
